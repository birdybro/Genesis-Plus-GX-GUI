set(fixture_directory
  "@CMAKE_CURRENT_BINARY_DIR@/windows-package-verification-fixture")
file(REMOVE_RECURSE "${fixture_directory}")
file(MAKE_DIRECTORY
  "${fixture_directory}/bin"
  "${fixture_directory}/plugins/platforms")

foreach(runtime IN ITEMS
    bin/genesis-plus-gx-gui.exe
    bin/Qt6Core.dll
    bin/SDL3.dll
    bin/librashader.dll
    share/Genesis-Plus-GX-GUI/shaders/genplusgx-crt.slangp
    share/Genesis-Plus-GX-GUI/shaders/genplusgx-crt.slang
    share/Genesis-Plus-GX-GUI/translations/genplusgx_en_XA.qm
    share/doc/Genesis-Plus-GX-GUI/librashader-MPL-2.0.md
    plugins/platforms/qwindows.dll)
  file(WRITE "${fixture_directory}/${runtime}" "package verification fixture")
endforeach()

execute_process(
  COMMAND
    "@CMAKE_COMMAND@"
    "-DPACKAGE_ROOT=${fixture_directory}"
    -DVERIFY_PLATFORM=windows
    -P "@PROJECT_SOURCE_DIR@/cmake/VerifyPackage.cmake"
  RESULT_VARIABLE missing_result
  OUTPUT_VARIABLE missing_output
  ERROR_VARIABLE missing_error
)
if(missing_result EQUAL 0)
  message(FATAL_ERROR
    "Windows package verification accepted a package without vc_redist.x64.exe")
endif()
if(NOT "${missing_output}${missing_error}" MATCHES "Visual C\\+\\+ x64 Redistributable")
  message(FATAL_ERROR
    "Missing-runtime rejection was not descriptive:\n${missing_output}${missing_error}")
endif()

file(WRITE
  "${fixture_directory}/vc_redist.x64.exe"
  "official redistributable fixture placeholder")
execute_process(
  COMMAND
    "@CMAKE_COMMAND@"
    "-DPACKAGE_ROOT=${fixture_directory}"
    -DVERIFY_PLATFORM=windows
    -P "@PROJECT_SOURCE_DIR@/cmake/VerifyPackage.cmake"
  RESULT_VARIABLE complete_result
  OUTPUT_VARIABLE complete_output
  ERROR_VARIABLE complete_error
)
if(NOT complete_result EQUAL 0)
  message(FATAL_ERROR
    "Complete Windows package fixture was rejected:\n${complete_output}${complete_error}")
endif()

file(MAKE_DIRECTORY "${fixture_directory}/bin/portable-data")
execute_process(
  COMMAND
    "@CMAKE_COMMAND@"
    "-DPACKAGE_ROOT=${fixture_directory}"
    -DVERIFY_PLATFORM=windows
    -P "@PROJECT_SOURCE_DIR@/cmake/VerifyPackage.cmake"
  RESULT_VARIABLE portable_payload_result
  OUTPUT_VARIABLE portable_payload_output
  ERROR_VARIABLE portable_payload_error
)
if(portable_payload_result EQUAL 0)
  message(FATAL_ERROR
    "Package verification accepted pre-created portable user data")
endif()
if(NOT "${portable_payload_output}${portable_payload_error}" MATCHES
   "pre-created portable user data")
  message(FATAL_ERROR
    "Portable-data rejection was not descriptive:\n"
    "${portable_payload_output}${portable_payload_error}")
endif()

file(REMOVE_RECURSE "${fixture_directory}")
