set(fixture_directory
  "@CMAKE_CURRENT_BINARY_DIR@/macos-translation-package-fixture")
set(bundle "${fixture_directory}/genesis-plus-gx-gui.app")
file(REMOVE_RECURSE "${fixture_directory}")

foreach(runtime IN ITEMS
    Contents/MacOS/genesis-plus-gx-gui
    Contents/Frameworks/QtCore.framework/Versions/A/QtCore
    Contents/Frameworks/QtNetwork.framework/Versions/A/QtNetwork
    Contents/Frameworks/libSDL3.dylib
    Contents/Frameworks/librashader.dylib
    Contents/PlugIns/platforms/libqcocoa.dylib
    Contents/Resources/shaders/genplusgx-crt.slangp
    Contents/Resources/shaders/genplusgx-crt.slang
    Contents/Resources/translations/genplusgx_en_XA.qm
    Contents/Resources/documentation/PHYSICAL_MEDIA.md
    Contents/Resources/documentation/NETPLAY.md
    Contents/Resources/documentation/ACHIEVEMENTS.md
    Contents/Resources/documentation/CLOUD_SYNC.md
    Contents/Resources/documentation/UPDATES.md
    Contents/Resources/documentation/ONLINE_METADATA.md
    Contents/Resources/licenses/librashader-MPL-2.0.md
    Contents/Resources/licenses/rcheevos-MIT.txt
    Contents/Resources/licenses/QtKeychain-BSD-3-Clause.txt
    Contents/Resources/licenses/Monocypher-BSD-2-Clause-or-CC0.md)
  get_filename_component(parent "${bundle}/${runtime}" DIRECTORY)
  file(MAKE_DIRECTORY "${parent}")
  file(WRITE "${bundle}/${runtime}" "package verification fixture")
endforeach()

execute_process(
  COMMAND
    "@CMAKE_COMMAND@"
    "-DPACKAGE_ROOT=${fixture_directory}"
    -DVERIFY_PLATFORM=macos
    -P "@PROJECT_SOURCE_DIR@/cmake/VerifyPackage.cmake"
  RESULT_VARIABLE complete_result
  OUTPUT_VARIABLE complete_output
  ERROR_VARIABLE complete_error
)
if(NOT complete_result EQUAL 0)
  message(FATAL_ERROR
    "Conventional macOS translation layout was rejected:\n"
    "${complete_output}${complete_error}")
endif()

file(MAKE_DIRECTORY "${bundle}/Contents/MacOS/translations")
file(WRITE
  "${bundle}/Contents/MacOS/translations/genplusgx_en_XA.qm"
  "duplicate package verification fixture")
execute_process(
  COMMAND
    "@CMAKE_COMMAND@"
    "-DPACKAGE_ROOT=${fixture_directory}"
    -DVERIFY_PLATFORM=macos
    -P "@PROJECT_SOURCE_DIR@/cmake/VerifyPackage.cmake"
  RESULT_VARIABLE duplicate_result
  OUTPUT_VARIABLE duplicate_output
  ERROR_VARIABLE duplicate_error
)
if(duplicate_result EQUAL 0)
  message(FATAL_ERROR
    "macOS package verification accepted a duplicate translation catalog")
endif()
if(NOT "${duplicate_output}${duplicate_error}" MATCHES
   "duplicate executable-directory translation catalog")
  message(FATAL_ERROR
    "Duplicate-catalog rejection was not descriptive:\n"
    "${duplicate_output}${duplicate_error}")
endif()

file(REMOVE_RECURSE "${fixture_directory}")
