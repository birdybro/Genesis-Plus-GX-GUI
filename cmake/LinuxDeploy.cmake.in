cmake_minimum_required(VERSION 3.25)

if(POLICY CMP0207)
  cmake_policy(SET CMP0207 NEW)
endif()

set(prefix "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
set(binary "${prefix}/@CMAKE_INSTALL_BINDIR@/genesis-plus-gx-gui")
set(library_directory "${prefix}/@CMAKE_INSTALL_LIBDIR@")
set(plugin_directory "${library_directory}/qt6/plugins")

if(NOT EXISTS "${binary}")
  message(FATAL_ERROR "Installed Linux executable is missing: ${binary}")
endif()

file(GLOB_RECURSE plugin_modules LIST_DIRECTORIES FALSE
  "${plugin_directory}/*.so")
if(NOT plugin_modules)
  message(FATAL_ERROR "No selected Qt plugins were installed")
endif()

# The official Qt archive gives its plugins a RUNPATH relative to the archive's
# original lib/plugins layout.  We deliberately install them one level deeper at
# lib/qt6/plugins so qt.conf can keep the package layout conventional.  Rewrite
# every copied plugin to find the Qt libraries in the package's lib directory;
# otherwise the dynamic loader can silently select an incompatible system
# libQt6XcbQpa and the XCB platform plugin fails before the window is created.
if(NOT EXISTS "@CMAKE_READELF@")
  message(FATAL_ERROR "CMAKE_READELF is required to validate Linux plugin RPATHs")
endif()
foreach(plugin_module IN LISTS plugin_modules)
  execute_process(
    COMMAND "@CMAKE_READELF@" -d "${plugin_module}"
    RESULT_VARIABLE readelf_result
    OUTPUT_VARIABLE readelf_output
    ERROR_VARIABLE readelf_error
  )
  if(NOT readelf_result EQUAL 0)
    message(FATAL_ERROR
      "Could not inspect ${plugin_module}: ${readelf_error}")
  endif()
  string(REGEX MATCH
    "(RPATH|RUNPATH)[^\n]*\\[([^]]*)\\]"
    plugin_rpath_match "${readelf_output}")
  if(NOT plugin_rpath_match)
    message(FATAL_ERROR "Qt plugin has no RPATH/RUNPATH: ${plugin_module}")
  endif()
  set(plugin_rpath "${CMAKE_MATCH_2}")
  set(expected_plugin_rpath "$ORIGIN/../../../")
  if(NOT plugin_rpath STREQUAL expected_plugin_rpath)
    file(RPATH_CHANGE
      FILE "${plugin_module}"
      OLD_RPATH "${plugin_rpath}"
      NEW_RPATH "${expected_plugin_rpath}"
    )
  endif()
endforeach()

file(GLOB staged_runtime_candidates LIST_DIRECTORIES FALSE
  "${library_directory}/*.so*")
set(staged_runtime_libraries)
foreach(candidate IN LISTS staged_runtime_candidates)
  file(REAL_PATH "${candidate}" real_candidate)
  list(APPEND staged_runtime_libraries "${real_candidate}")
endforeach()
list(REMOVE_DUPLICATES staged_runtime_libraries)

file(GET_RUNTIME_DEPENDENCIES
  EXECUTABLES "${binary}"
  LIBRARIES ${staged_runtime_libraries}
  MODULES ${plugin_modules}
  RESOLVED_DEPENDENCIES_VAR resolved_dependencies
  UNRESOLVED_DEPENDENCIES_VAR unresolved_dependencies
  CONFLICTING_DEPENDENCIES_PREFIX conflicting_dependencies
  PRE_EXCLUDE_REGEXES
    "^ld-linux.*"
    "^libc\\.so.*"
    "^libdl\\.so.*"
    "^libgcc_s\\.so.*"
    "^libm\\.so.*"
    "^libpthread\\.so.*"
    "^librt\\.so.*"
    "^libstdc\\+\\+\\.so.*"
    "^linux-vdso.*"
)

if(conflicting_dependencies_FILENAMES)
  set(unshipped_conflicts)
  foreach(dependency_name IN LISTS conflicting_dependencies_FILENAMES)
    if(NOT EXISTS "${library_directory}/${dependency_name}")
      list(APPEND unshipped_conflicts "${dependency_name}")
    endif()
  endforeach()
  if(unshipped_conflicts)
    list(JOIN unshipped_conflicts ", " conflict_text)
    message(FATAL_ERROR
      "Conflicting Linux dependencies are not staged: ${conflict_text}")
  endif()
endif()

if(unresolved_dependencies)
  set(missing_dependencies)
  foreach(dependency_name IN LISTS unresolved_dependencies)
    if(NOT EXISTS "${library_directory}/${dependency_name}")
      list(APPEND missing_dependencies "${dependency_name}")
    endif()
  endforeach()
  if(missing_dependencies)
    list(JOIN missing_dependencies ", " missing_text)
    message(FATAL_ERROR "Unresolved Linux package dependencies: ${missing_text}")
  endif()
endif()

file(WRITE "${prefix}/@CMAKE_INSTALL_BINDIR@/qt.conf"
  "[Paths]\nPrefix=..\nLibraries=@CMAKE_INSTALL_LIBDIR@\nPlugins=@CMAKE_INSTALL_LIBDIR@/qt6/plugins\n")

message(STATUS "Deployed selected Qt and SDL runtimes for the Linux package")
